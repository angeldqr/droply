  },
  "dependencies": {
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@reconectate/tooling": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
