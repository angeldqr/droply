# Copia este archivo a .env y completa los valores.
# El .env real nunca se versiona: está en .gitignore.
# Si falta cualquiera de estas variables, la app no arranca (packages/contracts/src/env).

NODE_ENV=development

# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=droply
POSTGRES_PASSWORD=
POSTGRES_DB=droply
DATABASE_URL=postgresql://droply:@localhost:5432/droply?schema=public

# ---- Redis ----------------------------------------------------------------
# REDIS_PASSWORD lo usa el compose para levantar el servidor; REDIS_URL lo usan
# las apps. Los dos tienen que coincidir.
REDIS_PASSWORD=
REDIS_URL=redis://:@localhost:6379

# ---- Almacenamiento de objetos (MinIO en local, S3/R2 en producción) ------
# Esta URL tiene que ser la que alcanza el navegador, no un nombre interno de
# la red de Docker: con ella se firman las subidas y el navegador las resuelve.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=droply-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Las URLs firmadas viven poco: son de un solo uso práctico.
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ---- Autenticación --------------------------------------------------------
# Genera con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Clave de 32 bytes en base64 para cifrar el token del bot en la base.
# Genera con: openssl rand -base64 32
ENCRYPTION_KEY=

# ---- Telegram -------------------------------------------------------------
# Token que te da @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Cabecera que Telegram devuelve en cada webhook; si no coincide, se descarta.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# ---- Correo ---------------------------------------------------------------
# 'log' escribe el enlace de verificación en la consola en vez de enviarlo.
# Solo para desarrollo: ese enlace alcanza para tomar la cuenta.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-responder@droply.app

# ---- URLs públicas --------------------------------------------------------
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
