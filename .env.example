# Copia este archivo a .env y completa los valores.
# El .env real nunca se versiona: está en .gitignore.
# Si falta cualquiera de estas variables, la app no arranca (packages/contracts/src/env).

NODE_ENV=development

# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=reconectate
POSTGRES_PASSWORD=
POSTGRES_DB=reconectate
DATABASE_URL=postgresql://reconectate:@localhost:5432/reconectate?schema=public

# ---- Almacenamiento de objetos (MinIO en local, S3/R2 en producción) ------
# Esta URL tiene que ser la que alcanza el navegador, no un nombre interno de
# la red de Docker: con ella se firman las subidas y el navegador las resuelve.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=reconectate-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Las URLs firmadas viven poco: son de un solo uso práctico.
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ---- Autenticación --------------------------------------------------------
# Genera con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Clave de 32 bytes en base64 para cifrar el token del bot en la base.
# Genera con: openssl rand -base64 32
ENCRYPTION_KEY=

# ---- Telegram -------------------------------------------------------------
# Token que te da @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Cabecera que Telegram devuelve en cada webhook; si no coincide, se descarta.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# ---- Correo ---------------------------------------------------------------
# Tres transportes:
#   resend  el de la máquina virtual. Va por HTTPS, así que no le afecta que el
#           proveedor bloquee los puertos de SMTP salientes, que es lo normal.
#   smtp    la salida, si algún día Resend no sirve. Pide SMTP_HOST.
#   log     escribe el enlace en la consola en vez de enviarlo. Solo para
#           desarrollo: ese enlace alcanza para tomar la cuenta.
MAIL_TRANSPORT=log

# Con MAIL_TRANSPORT=resend. El dominio de MAIL_FROM tiene que estar verificado
# en Resend, o los correos salen pero no llegan.
RESEND_API_KEY=

# Con MAIL_TRANSPORT=smtp. Para la bandeja de mentira del desarrollo:
# SMTP_HOST=localhost y SMTP_PORT=1025 (docker compose --profile dev up -d mailpit).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM=no-responder@reconectate.cloud

# ---- URLs públicas --------------------------------------------------------
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# La que ve el navegador. Next la incrusta en el JavaScript AL CONSTRUIR, no al
# arrancar, así que cambiarla obliga a reconstruir el front.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Solo para el despliegue ----------------------------------------------
# Los usa el compose, no la aplicación. En desarrollo se dejan vacíos.
#
# Los tres nombres tienen que colgar del mismo dominio registrable: la cookie de
# refresco sale con sameSite=strict, así que reconectate.cloud y api.reconectate.cloud valen,
# pero dos dominios distintos no. Los tres apuntan por DNS a la máquina virtual.
#
# En la máquina virtual, además:
#   WEB_URL=https://reconectate.cloud
#   API_URL=https://api.reconectate.cloud
#   NEXT_PUBLIC_API_URL=https://api.reconectate.cloud
#   STORAGE_ENDPOINT=https://archivos.reconectate.cloud
#   TELEGRAM_WEBHOOK_URL=https://api.reconectate.cloud/api/telegram/webhook
WEB_DOMAIN=
API_DOMAIN=
STORAGE_DOMAIN=

# Adonde avisa Let's Encrypt si un certificado va a vencer sin renovarse.
ACME_EMAIL=

# La cuenta que administra. No hay registro abierto: quien administra crea las
# demas cuentas. Al arrancar, el API asciende esta cuenta si ya existe, o la crea
# con la contrasena de abajo si todavia no. Dejarlo puesto no hace dano: la
# operacion es idempotente y nunca le quita el rol a nadie.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
