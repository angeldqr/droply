// Los modelos entran junto con su contexto, no todos de golpe: identity en la
// fase 1, libraries en la 2, y así.
//
// Las columnas van en snake_case con @map. Prisma las expone en camelCase al
// código igual, pero del lado de Postgres una columna camelCase obliga a
// entrecomillarla en cada consulta suelta, y basta olvidarse una vez para que
// falle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// identity
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

model User {
  id           String   @id @db.Uuid
  email        String   @unique
  /// Quien administra crea las cuentas y ve los metadatos de todas. No hay
  /// registro abierto: el rol solo lo da otro administrador o el script de
  /// arranque.
  role         UserRole @default(USER)
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")

  /// Zona IANA. Define a qué hora real llega cada envío programado.
  timezone String

  emailVerifiedAt DateTime? @map("email_verified_at")

  /// Cuando quien administra le corto el acceso. No se borra la cuenta: sus
  /// bibliotecas y sus envios siguen ahi por si vuelve, pero no puede entrar.
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens     RefreshToken[]
  verificationCodes EmailVerification[]
  passwordResets    PasswordReset[]
  libraries         Library[]
  recipients        Recipient[]
  schedules         Schedule[]
  notices           Notice[]
  habitPlans        HabitPlan[]

  @@map("users")
}

/// Un refresh token vivo. Se guarda el hash, nunca el valor: si alguien lee la
/// tabla no puede hacerse pasar por nadie.
///
/// `familyId` agrupa toda la cadena de rotaciones que nació de un mismo login.
/// Si aparece un token ya rotado, la familia entera cae.
model RefreshToken {
  id        String @id @db.Uuid
  userId    String @map("user_id") @db.Uuid
  familyId  String @map("family_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  /// Se sella cuando el token se canjea por uno nuevo.
  rotatedAt DateTime? @map("rotated_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// libraries
// ---------------------------------------------------------------------------

model Library {
  id          String  @id @db.Uuid
  ownerId     String  @map("owner_id") @db.Uuid
  name        String
  description String?

  /// El baul es una biblioteca mas, solo que marcada: subir, ordenar y quitar
  /// funcionan igual sin una segunda tabla. Lo unico distinto es que no sale en
  /// el listado y no se puede renombrar ni borrar. Un indice unico parcial
  /// (en la migracion) deja uno solo por cuenta.
  isVault Boolean @default(false) @map("is_vault")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items      LibraryItem[]
  schedules  Schedule[]
  recipients LibraryRecipient[]

  @@index([ownerId])
  @@map("libraries")
}

enum ItemKind {
  AUDIO
  VIDEO
  IMAGE
  TEXT

  @@map("item_kind")
}

/// Un elemento de una columna. `position` es un decimal a propósito: para
/// insertar entre dos vecinos alcanza con promediarlos, en vez de renumerar la
/// columna entera en cada arrastre.
model LibraryItem {
  id        String   @id @db.Uuid
  libraryId String   @map("library_id") @db.Uuid
  kind      ItemKind
  position  Float

  /// Los elementos de texto guardan su contenido acá mismo; el resto apunta a
  /// un objeto del almacenamiento.
  textContent String? @map("text_content")

  /// La clave del objeto en el bucket: `ownerId/libraryId/itemId`. Sin el
  /// nombre de archivo del usuario, que no aporta nada y traería caracteres
  /// raros y recorridos de ruta.
  storageKey String? @map("storage_key")
  /// El nombre con el que llegó, solo para mostrarlo. No entra en la clave del
  /// objeto: ahí traería caracteres raros y recorridos de ruta.
  fileName   String? @map("file_name")
  mimeType   String? @map("mime_type")
  sizeBytes  Int?    @map("size_bytes")

  /// Cuantas veces al dia se manda este elemento. Los envios se reparten de
  /// extremo a extremo de la franja del horario: con tres, sale a la primera
  /// hora, a la del medio y a la ultima.
  timesPerDay Int @default(1) @map("times_per_day")

  /// En null mientras el permiso de subida está firmado pero el archivo no se
  /// ha verificado. Una verificación fallida no deja rastro: se borra el objeto
  /// y se borra la fila, así que no hace falta un estado de error.
  mediaReadyAt DateTime? @map("media_ready_at")

  createdAt DateTime @default(now()) @map("created_at")

  library Library             @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  fixedIn ScheduleFixedItem[]

  @@index([libraryId, kind, position])
  @@map("library_items")
}

/// Un enlace para volver a poner la contrasena.
///
/// Misma forma que EmailVerification y por la misma razon: el valor se manda
/// por correo y de el solo se guarda el hash, asi que quien lea la tabla no
/// puede entrar a nombre de nadie. Se quema al usarse.
model PasswordReset {
  id        String @id @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model EmailVerification {
  id        String @id @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

enum RecipientChannel {
  TELEGRAM

  @@map("recipient_channel")
}

/// A quien le llegan los envios.
///
/// Un bot de Telegram no puede escribirle a alguien que nunca le hablo, asi que
/// un destinatario nace **pendiente**: solo tiene la etiqueta que le puso su
/// dueño y un codigo de un solo uso. Cuando esa persona abre el enlace y aprieta
/// Empezar, el bot recibe el codigo y recien ahi se conoce su `externalId`.
model Recipient {
  id      String           @id @db.Uuid
  ownerId String           @map("owner_id") @db.Uuid
  label   String
  channel RecipientChannel @default(TELEGRAM)

  /// El chat_id de Telegram. Nulo mientras el destinatario no se vinculo.
  externalId String? @map("external_id")

  /// El codigo de vinculacion se guarda hasheado, igual que los de refresco:
  /// quien lea la tabla no puede vincularse haciendose pasar por otro.
  linkCodeHash      String?   @unique @map("link_code_hash")
  linkCodeExpiresAt DateTime? @map("link_code_expires_at")

  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  schedules  Schedule[]
  libraries  LibraryRecipient[]
  habitPlans HabitPlan[]

  /// La misma persona no se vincula dos veces a la misma cuenta. Postgres trata
  /// los nulos como distintos entre si, asi que los pendientes no chocan.
  @@unique([ownerId, channel, externalId])
  @@index([ownerId])
  @@map("recipients")
}

/// Cuando sale un envio y de donde.
///
/// `weekdays` son los dias (1 lunes .. 7 domingo) y `startMinute`/`endMinute`
/// la franja en minutos desde medianoche. `timezone` es la zona IANA en la que
/// se interpretan: sin la zona, "todos los dias a las 8" cambia de hora sola dos
/// veces al año. `nextRunAt` se guarda en UTC y es lo unico que mira el tick,
/// asi que el indice de vencidos no depende de recalcular la regla.
model Schedule {
  id          String @id @db.Uuid
  ownerId     String @map("owner_id") @db.Uuid
  libraryId   String @map("library_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  /// Que dias de la semana sale, con 1 = lunes y 7 = domingo, como Luxon.
  /// Nunca vacio: un horario sin dias no se disparara jamas.
  weekdays Int[]

  /// La franja del dia en minutos desde medianoche, en la zona de abajo.
  /// `endMinute` es estrictamente mayor que `startMinute`.
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  timezone String

  /// Con qué nombre firma este horario sus envios. Nulo = el nombre de la
  /// cuenta, que es el caso normal. Existe porque quien manda no siempre es el
  /// dueño de la cuenta: un padre que le programa cosas a su hijo quiere que
  /// llegue firmado como el, no como Reconéctate.
  senderName String? @map("sender_name")

  /// Si esta puesto, solo se eligen elementos de esa columna.
  kindFilter ItemKind? @map("kind_filter")

  active    Boolean   @default(true)
  nextRunAt DateTime? @map("next_run_at")
  lastRunAt DateTime? @map("last_run_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  library   Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  deliveries DeliveryAttempt[]
  fixedItems ScheduleFixedItem[]

  /// El indice del tick: solo activos y vencidos, que es la unica consulta que
  /// corre cada minuto.
  @@index([active, nextRunAt])
  @@index([ownerId])
  @@map("schedules")
}

/// Un envio clavado: a esta hora sale este archivo y no otro.
///
/// La clave primaria es (horario, minuto) porque una hora no puede llevar dos
/// cosas. Lo impide la base y no una comprobacion en el codigo, que hay que
/// acordarse de repetir en cada camino nuevo que escriba en esta tabla.
///
/// El minuto vive aca y no en el elemento porque un envio fijo es la suma de
/// archivo, hora y persona: el mismo video puede ir a las 6 para uno y no salir
/// nunca para otro, y eso solo se puede decir desde el horario.
model ScheduleFixedItem {
  scheduleId String @map("schedule_id") @db.Uuid
  /// Minutos desde medianoche, siempre dentro de la franja del horario.
  minute     Int
  itemId     String @map("item_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  schedule Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  item     LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Si el archivo se borra, el envio fijo se va con el: la alternativa seria
  /// un horario que a las 6 no manda nada y no dice por que.
  @@id([scheduleId, minute])
  @@index([itemId])
  @@map("schedule_fixed_items")
}

/// A quien se le puede enviar lo de esta biblioteca.
///
/// Sin esta tabla, cualquier biblioteca podia programarse hacia cualquier
/// destinatario de la cuenta. Tener tres bibliotecas no significa que las tres
/// vayan a las mismas personas: las fotos de la abuela no son para el grupo del
/// trabajo. El baul nunca tiene filas aca; es personal y no sale hacia nadie.
model LibraryRecipient {
  libraryId   String @map("library_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  library   Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([libraryId, recipientId])
  @@index([recipientId])
  @@map("library_recipients")
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED
  /// Fallo pasajero: se vuelve a intentar cuando llegue `nextAttemptAt`.
  RETRYING

  @@map("delivery_status")
}

/// Lo que salio, hacia quien y con que resultado.
///
/// `occurrenceKey` es `horario:instante` y es unico: es lo que impide que un
/// reintento del tick, o dos replicas a la vez, manden dos veces lo mismo. La
/// unicidad la garantiza el indice, no una comprobacion previa.
model DeliveryAttempt {
  id            String         @id @db.Uuid
  scheduleId    String         @map("schedule_id") @db.Uuid
  itemId        String?        @map("item_id") @db.Uuid
  occurrenceKey String         @unique @map("occurrence_key")
  status        DeliveryStatus

  /// El identificador que devuelve Telegram, para poder rastrear un envio.
  providerMessageId String? @map("provider_message_id")
  /// Por que fallo, en el idioma del proveedor. Solo para diagnosticar.
  error             String?

  /// Cuantas veces se reintento ya. Al llegar al tope se rinde y queda FAILED.
  retryCount    Int       @default(0) @map("retry_count")
  /// Cuando toca el siguiente reintento. Solo tiene valor mientras esta
  /// RETRYING; es lo unico que mira la consulta de reintentos vencidos.
  nextAttemptAt DateTime? @map("next_attempt_at")

  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, occurredAt])
  /// El indice de los reintentos vencidos, que es la otra consulta por minuto.
  @@index([status, nextAttemptAt])
  @@map("delivery_attempts")
}

/// Un aviso para el dueno de una cuenta.
///
/// Existe porque el unico chat que la aplicacion conoce de una cuenta es el de
/// sus destinatarios, que son otras personas: avisarle por ahi de que un envio
/// fallo seria contarle a un tercero como anda la cuenta ajena. Asi que el
/// aviso vive dentro de la aplicacion, que es donde el dueno ya va a mirar.
model Notice {
  id      String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  text   String
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, readAt])
  @@map("notices")
}

// ---------------------------------------------------------------------------
// habits
// ---------------------------------------------------------------------------

enum HabitPlanStatus {
  ACTIVE
  /// Lo anulo su dueño antes de tiempo. Las bibliotecas quedan libres.
  CANCELLED
  /// Llego a su ultimo dia. Ya no se toca; solo se puede reenviar el informe.
  CLOSED

  @@map("habit_plan_status")
}

enum HabitAnswer {
  DONE
  /// El boton del medio: se hizo a medias y vale la mitad.
  HALF
  MISSED

  @@map("habit_answer")
}

/// Un plan de habitos: un destinatario, unas cuantas bibliotecas y un plazo.
///
/// Cada biblioteca del plan se comporta como un habito. Mientras el plan este
/// vivo, todo lo que salga de esas bibliotecas hacia ese destinatario llega con
/// tres botones —realizado, a medias, no cumplido— y la respuesta se cuenta.
///
/// `timezone` se copia de la cuenta al crearlo y no se vuelve a leer de ahi: el
/// dia de un plan tiene que seguir cortandose donde se corto siempre, aunque su
/// dueño se mude de pais a mitad de los treinta dias.
///
/// `scoredThrough` es el ultimo dia con la cuenta cerrada. Es lo unico que mira
/// el latido, y avanza de a un dia: si el proceso estuvo caido dos dias, se
/// pone al dia en dos vueltas en vez de saltarselos en silencio.
model HabitPlan {
  id          String @id @db.Uuid
  ownerId     String @map("owner_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  name String

  /// 7, 14, 21 o 30. El vocabulario cerrado vive en el contrato.
  durationDays Int @map("duration_days")

  /// Zona IANA en la que se corta el dia de este plan.
  timezone String

  /// Primer y ultimo dia, los dos inclusive, como fechas civiles de esa zona.
  startOn DateTime @map("start_on") @db.Date
  endOn   DateTime @map("end_on") @db.Date

  status HabitPlanStatus @default(ACTIVE)

  /// Hasta que dia esta cerrada la cuenta. Nulo mientras no cerro ninguno.
  scoredThrough DateTime? @map("scored_through") @db.Date

  closedAt     DateTime? @map("closed_at")
  reportSentAt DateTime? @map("report_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  habits HabitPlanLibrary[]
  days   HabitDayScore[]

  @@index([ownerId, status])
  /// El indice del latido: solo vivos, ordenados por lo que falta por cerrar.
  @@index([status, scoredThrough])
  @@map("habit_plans")
}

/// Una biblioteca dentro de un plan, o sea un habito.
///
/// **No hay clave foranea hacia `libraries`, y es a proposito.** Es la misma
/// decision que ya tomo `DeliveryAttempt.itemId`: un plan terminado es un
/// registro historico, y si borrar una biblioteca arrastrara sus filas, los
/// planes viejos perderian habitos sin decir nada. Por eso `label` guarda el
/// nombre con el que la biblioteca entro: sobrevive a que la borren.
///
/// `recipientId` y `active` estan copiados del plan solo para sostener un
/// indice unico parcial —escrito a mano en la migracion, porque Prisma no los
/// declara— sobre (biblioteca, destinatario) de los planes vivos.
///
/// El indice va sobre los dos y no sobre la biblioteca sola, y es la diferencia
/// que importa: la misma biblioteca **si** puede estar en dos planes a la vez
/// mientras vayan a personas distintas —son horarios distintos y envios
/// distintos, asi que ninguna respuesta queda ambigua—. Lo que no puede es
/// estar dos veces hacia la misma persona: ese envio llegaria con dos juegos de
/// botones y la respuesta no sabria a cual pertenece.
model HabitPlanLibrary {
  planId      String @map("plan_id") @db.Uuid
  libraryId   String @map("library_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  label String

  active Boolean @default(true)

  plan HabitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, libraryId])
  @@index([libraryId, recipientId, active])
  @@map("habit_plan_libraries")
}

/// La respuesta a un envio, tal como la apreto quien lo recibio.
///
/// El identificador del envio **es** la clave primaria, y eso es lo que hace
/// cumplir que una votacion no se pueda cambiar: el segundo toque choca contra
/// el indice. La unicidad la decide la base y no una consulta previa, que dos
/// toques a la vez podrian pasar los dos.
///
/// Tampoco hay clave foranea hacia `delivery_attempts`, por lo mismo que arriba:
/// borrar un horario no puede llevarse por delante lo que alguien ya respondio.
model HabitResponse {
  deliveryId String      @id @map("delivery_id") @db.Uuid
  planId     String      @map("plan_id") @db.Uuid
  libraryId  String      @map("library_id") @db.Uuid
  answer     HabitAnswer

  answeredAt DateTime @map("answered_at")

  @@index([planId, libraryId])
  @@map("habit_responses")
}

/// El resultado de un dia ya cerrado, por habito.
///
/// Se guarda calculado en vez de sumarse cada vez que alguien abre la pantalla:
/// un plan cerrado tiene que enseñar siempre lo mismo, y volver a sumarlo desde
/// los envios daria otro numero en cuanto se borre una biblioteca o un horario.
///
model HabitDayScore {
  planId    String   @map("plan_id") @db.Uuid
  libraryId String   @map("library_id") @db.Uuid
  day       DateTime @db.Date

  sent     Int
  /// Cuantos de esos envios tuvieron respuesta. No se deduce de `earned`:
  /// tres realizados y dos no cumplidos suman tres, pero se respondieron cinco.
  answered Int
  /// Suma de los valores: uno por realizado, medio por a medias, cero por lo
  /// demas —incluido no contestar—.
  earned   Float

  plan HabitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, libraryId, day])
  @@map("habit_day_scores")
}
