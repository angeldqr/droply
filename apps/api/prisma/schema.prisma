// Los modelos entran junto con su contexto, no todos de golpe: identity en la
// fase 1, libraries en la 2, y así.
//
// Las columnas van en snake_case con @map. Prisma las expone en camelCase al
// código igual, pero del lado de Postgres una columna camelCase obliga a
// entrecomillarla en cada consulta suelta, y basta olvidarse una vez para que
// falle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// identity
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

model User {
  id           String   @id @db.Uuid
  email        String   @unique
  /// Quien administra crea las cuentas y ve los metadatos de todas. No hay
  /// registro abierto: el rol solo lo da otro administrador o el script de
  /// arranque.
  role         UserRole @default(USER)
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")

  /// Zona IANA. Define a qué hora real llega cada envío programado.
  timezone String

  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens     RefreshToken[]
  verificationCodes EmailVerification[]
  libraries         Library[]
  recipients        Recipient[]
  schedules         Schedule[]

  @@map("users")
}

/// Un refresh token vivo. Se guarda el hash, nunca el valor: si alguien lee la
/// tabla no puede hacerse pasar por nadie.
///
/// `familyId` agrupa toda la cadena de rotaciones que nació de un mismo login.
/// Si aparece un token ya rotado, la familia entera cae.
model RefreshToken {
  id        String @id @db.Uuid
  userId    String @map("user_id") @db.Uuid
  familyId  String @map("family_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  /// Se sella cuando el token se canjea por uno nuevo.
  rotatedAt DateTime? @map("rotated_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// libraries
// ---------------------------------------------------------------------------

model Library {
  id          String  @id @db.Uuid
  ownerId     String  @map("owner_id") @db.Uuid
  name        String
  description String?

  /// El baul es una biblioteca mas, solo que marcada: subir, ordenar y quitar
  /// funcionan igual sin una segunda tabla. Lo unico distinto es que no sale en
  /// el listado y no se puede renombrar ni borrar. Un indice unico parcial
  /// (en la migracion) deja uno solo por cuenta.
  isVault     Boolean @default(false) @map("is_vault")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items      LibraryItem[]
  schedules  Schedule[]
  recipients LibraryRecipient[]

  @@index([ownerId])
  @@map("libraries")
}

enum ItemKind {
  AUDIO
  VIDEO
  IMAGE
  TEXT

  @@map("item_kind")
}

/// Un elemento de una columna. `position` es un decimal a propósito: para
/// insertar entre dos vecinos alcanza con promediarlos, en vez de renumerar la
/// columna entera en cada arrastre.
model LibraryItem {
  id        String   @id @db.Uuid
  libraryId String   @map("library_id") @db.Uuid
  kind      ItemKind
  position  Float

  /// Los elementos de texto guardan su contenido acá mismo; el resto apunta a
  /// un objeto del almacenamiento.
  textContent String? @map("text_content")

  /// La clave del objeto en el bucket: `ownerId/libraryId/itemId`. Sin el
  /// nombre de archivo del usuario, que no aporta nada y traería caracteres
  /// raros y recorridos de ruta.
  storageKey String? @map("storage_key")
  /// El nombre con el que llegó, solo para mostrarlo. No entra en la clave del
  /// objeto: ahí traería caracteres raros y recorridos de ruta.
  fileName   String? @map("file_name")
  mimeType   String? @map("mime_type")
  sizeBytes  Int?    @map("size_bytes")

  /// Cuantas veces al dia se manda este elemento. Los envios se reparten de
  /// extremo a extremo de la franja del horario: con tres, sale a la primera
  /// hora, a la del medio y a la ultima.
  timesPerDay Int @default(1) @map("times_per_day")

  /// En null mientras el permiso de subida está firmado pero el archivo no se
  /// ha verificado. Una verificación fallida no deja rastro: se borra el objeto
  /// y se borra la fila, así que no hace falta un estado de error.
  mediaReadyAt DateTime? @map("media_ready_at")

  createdAt DateTime @default(now()) @map("created_at")

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId, kind, position])
  @@map("library_items")
}

model EmailVerification {
  id        String @id @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

enum RecipientChannel {
  TELEGRAM

  @@map("recipient_channel")
}

/// A quien le llegan los envios.
///
/// Un bot de Telegram no puede escribirle a alguien que nunca le hablo, asi que
/// un destinatario nace **pendiente**: solo tiene la etiqueta que le puso su
/// dueño y un codigo de un solo uso. Cuando esa persona abre el enlace y aprieta
/// Empezar, el bot recibe el codigo y recien ahi se conoce su `externalId`.
model Recipient {
  id      String           @id @db.Uuid
  ownerId String           @map("owner_id") @db.Uuid
  label   String
  channel RecipientChannel @default(TELEGRAM)

  /// El chat_id de Telegram. Nulo mientras el destinatario no se vinculo.
  externalId String? @map("external_id")

  /// El codigo de vinculacion se guarda hasheado, igual que los de refresco:
  /// quien lea la tabla no puede vincularse haciendose pasar por otro.
  linkCodeHash      String?   @unique @map("link_code_hash")
  linkCodeExpiresAt DateTime? @map("link_code_expires_at")

  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  schedules  Schedule[]
  libraries  LibraryRecipient[]

  /// La misma persona no se vincula dos veces a la misma cuenta. Postgres trata
  /// los nulos como distintos entre si, asi que los pendientes no chocan.
  @@unique([ownerId, channel, externalId])
  @@index([ownerId])
  @@map("recipients")
}

enum SelectionStrategy {
  RANDOM
  RANDOM_NO_REPEAT
  SEQUENTIAL

  @@map("selection_strategy")
}

/// Cuando sale un envio y de donde.
///
/// `rrule` es la regla en texto (RFC 5545) y `timezone` la zona IANA en la que
/// se interpreta: sin la zona, "todos los dias a las 8" cambia de hora sola dos
/// veces al año. `nextRunAt` se guarda en UTC y es lo unico que mira el tick,
/// asi que el indice de vencidos no depende de recalcular la regla.
model Schedule {
  id          String @id @db.Uuid
  ownerId     String @map("owner_id") @db.Uuid
  libraryId   String @map("library_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  /// Que dias de la semana sale, con 1 = lunes y 7 = domingo, como Luxon.
  /// Nunca vacio: un horario sin dias no se disparara jamas.
  weekdays Int[]

  /// La franja del dia en minutos desde medianoche, en la zona de abajo.
  /// `endMinute` es estrictamente mayor que `startMinute`.
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  timezone String

  /// Con qué nombre firma este horario sus envios. Nulo = el nombre de la
  /// cuenta, que es el caso normal. Existe porque quien manda no siempre es el
  /// dueño de la cuenta: un padre que le programa cosas a su hijo quiere que
  /// llegue firmado como el, no como Droply.
  senderName String? @map("sender_name")

  strategy SelectionStrategy @default(RANDOM)

  /// Si esta puesto, solo se eligen elementos de esa columna.
  kindFilter ItemKind? @map("kind_filter")

  active    Boolean   @default(true)
  nextRunAt DateTime? @map("next_run_at")
  lastRunAt DateTime? @map("last_run_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  library   Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  sent       SentItem[]
  deliveries DeliveryAttempt[]

  /// El indice del tick: solo activos y vencidos, que es la unica consulta que
  /// corre cada minuto.
  @@index([active, nextRunAt])
  @@index([ownerId])
  @@map("schedules")
}

/// La bolsa del "aleatorio sin repetir": lo que este horario ya envio.
///
/// Una fila por elemento y no un array en `schedules`, para que dos ticks
/// simultaneos no se pisen la bolsa entera al escribirla.
model SentItem {
  scheduleId String   @map("schedule_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  sentAt     DateTime @default(now()) @map("sent_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@id([scheduleId, itemId])
  @@map("sent_items")
}

/// A quien se le puede enviar lo de esta biblioteca.
///
/// Sin esta tabla, cualquier biblioteca podia programarse hacia cualquier
/// destinatario de la cuenta. Tener tres bibliotecas no significa que las tres
/// vayan a las mismas personas: las fotos de la abuela no son para el grupo del
/// trabajo. El baul nunca tiene filas aca; es personal y no sale hacia nadie.
model LibraryRecipient {
  libraryId   String @map("library_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  library   Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([libraryId, recipientId])
  @@index([recipientId])
  @@map("library_recipients")
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED

  @@map("delivery_status")
}

/// Lo que salio, hacia quien y con que resultado.
///
/// `occurrenceKey` es `horario:instante` y es unico: es lo que impide que un
/// reintento del tick, o dos replicas a la vez, manden dos veces lo mismo. La
/// unicidad la garantiza el indice, no una comprobacion previa.
model DeliveryAttempt {
  id            String         @id @db.Uuid
  scheduleId    String         @map("schedule_id") @db.Uuid
  itemId        String?        @map("item_id") @db.Uuid
  occurrenceKey String         @unique @map("occurrence_key")
  status        DeliveryStatus

  /// El identificador que devuelve Telegram, para poder rastrear un envio.
  providerMessageId String? @map("provider_message_id")
  /// Por que fallo, en el idioma del proveedor. Solo para diagnosticar.
  error             String?

  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, occurredAt])
  @@map("delivery_attempts")
}
