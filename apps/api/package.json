    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.1.0",
    "fastify": "^5.2.0",
    "nestjs-pino": "^4.2.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@droply/tooling": "workspace:*",
